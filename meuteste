def calculadora():
     print("----> Bem-vindo à calculadora <----")
     calculo1 = input("Digite o primeiro número: ")
     calculo2 = input("Digite o segundo número: ")
     
     operacao = input("Digite a operação desejada para o cálculo: (+, -, *, /): ")
     
     if operacao == "+":
         resultado = float(calculo1) + float(calculo2)
         print(f"O resultado da soma é: {resultado}")
     elif operacao == "-":
         resultado = float(calculo1) - float(calculo2)
         print(f"O resultado da subtração é: {resultado}")
     elif operacao == "*":
         resultado = float(calculo1) * float(calculo2)
         print(f"O resultado da multiplicação é: {resultado}")
     elif operacao == "/":
         if float(calculo2) == 0:
             print("Não é possível dividir por zero.")
         else:
             resultado = float(calculo1) / float(calculo2)
             print(f"O resultado da divisão é: {resultado}")
     else:
         print("Operação inválida.")
